# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# pdf.js copiado no postinstall (scripts/copiar-pdfjs.mjs)
/public/pdfjs/

# arquivos reais usados em teste local (dados de fundos não vão para o Git)
/public/_teste/

# Claude Code
/.claude/worktrees/

# Python (versão SimplificaHub em nix_auditoria/)
__pycache__/
*.pyc
.pytest_cache/
