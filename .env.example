# Copie para .env.local (fica fora do Git) e preencha. Na Vercel: Settings → Environment Variables.

# Britech da Planner (ambiente "delta") — usuário e senha da API
BRITECH_USUARIO=
BRITECH_SENHA=
# BRITECH_URL=https://delta.britech.com.br/WS/api

# Britech das outras administradoras: um trio por administradora (código em maiúsculas, sem espaço).
# Gere a partir da planilha de acessos (grava no .env.local sem mostrar senha):
#   node scripts/importar-acessos-britech.mjs "G:\Drives compartilhados\Dados\Acessos\Acessos.xlsx"
# BRITECH_ID_URL=https://id.britech.com.br/WS/api
# BRITECH_ID_USUARIO=
# BRITECH_ID_SENHA=

# Fromtis (estoque de recebíveis por API SOAP): endereço, usuário e senha do webservice de cada administradora.
# FROMTIS_AZUMI_URL=https://<servidor-do-fromtis-da-administradora>
# FROMTIS_AZUMI_USUARIO=
# FROMTIS_AZUMI_SENHA=

# Pasta da administradora no trimestre (dentro dela: _Workpapers, Lastro e Termo, _Carteiras\FORMATADA)
# LASTRO_DRIVE_BASE=G:\Drives compartilhados\Auditoria de Lastro – 1º Semestre – 2026\2T2026\PLANNER
# Raízes que o app pode ler (separe com ;)
# LASTRO_DRIVE_RAIZES=G:\Drives compartilhados

# Só a rede do escritório acessa o app publicado (Vercel): IPs públicos e faixas CIDR, separados por vírgula.
# Quem vem desses IPs não precisa da chave abaixo. Ex.: LASTRO_IPS_PERMITIDOS=203.0.113.10
# LASTRO_IPS_PERMITIDOS=

# Obrigatória fora do seu computador (Vercel) para quem não está na rede liberada acima.
# Com ela configurada, a chave é pedida sempre, inclusive localmente.
# LASTRO_CHAVE_ACESSO=
